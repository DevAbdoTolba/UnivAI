# secrets — never commit
.env

# python
.venv/
__pycache__/
*.pyc

# node
node_modules/
.next/
out/
next-env.d.ts

# uploaded books (user data)
uploads/

# Generated course content — slides, scripts, quizzes, the lecturer's
# pre-rendered voice, the semester plan. All of it is written by the course
# builder (UnivAI-Agent/generation/lecture_gen.py) from a learner's uploaded
# book, so it is per-learner data rather than source: it rebuilds from the book
# and it churns on every regenerate. Only the README explaining the folder is
# tracked, so a fresh clone still gets lectures/ and its documentation.
lectures/*
!lectures/README.md

# all service + build logs live here (see docs/running.md)
logs/
# log strays at the repo root
/*.log
/*.err

# caches (voice models live in UnivAI-live/models/, ignored by that repo)
.cache/
# rendered narration, rebuilt on demand from lecture_artifacts.script_payload
.audio-cache/
demo-media/

# os
Thumbs.db
.DS_Store

# generated by scripts/build-slides.mjs (run: make slides)
UnivAI-app/public/slides/
.audio-cache/
