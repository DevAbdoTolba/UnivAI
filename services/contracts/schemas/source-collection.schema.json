{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://univai.local/contracts/source-collection-v1",
  "title": "UnivAI Source Collection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_id",
    "owner_id",
    "status",
    "documents",
    "error",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "source-collection-v1"
    },
    "collection_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "ingesting", "ready", "failed"]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceDocument"
      }
    },
    "error": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "documents": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/sourceDocument"
                },
                {
                  "properties": {
                    "status": {
                      "const": "ready"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "filename",
        "title",
        "media_type",
        "page_count",
        "status",
        "error",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": ["registered", "ingesting", "ready", "failed"]
        },
        "error": {
          "type": ["string", "null"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ingestionJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "collection_id",
        "document_id",
        "owner_id",
        "idempotency_key",
        "status",
        "error",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {
          "const": "source-collection-v1"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "collection_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["queued", "ingesting", "ready", "failed"]
        },
        "error": {
          "type": ["string", "null"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "schema_version": "source-collection-v1",
      "collection_id": "collection-demo-001",
      "owner_id": "S-2026-000001",
      "status": "ready",
      "documents": [
        {
          "document_id": "book-algorithms",
          "filename": "algorithms.pdf",
          "title": "Algorithms",
          "media_type": "application/pdf",
          "page_count": 420,
          "status": "ready",
          "error": null,
          "created_at": "2026-07-30T09:00:00Z",
          "updated_at": "2026-07-30T09:10:00Z"
        },
        {
          "document_id": "book-databases",
          "filename": "databases.pdf",
          "title": "Databases",
          "media_type": "application/pdf",
          "page_count": 360,
          "status": "ready",
          "error": null,
          "created_at": "2026-07-30T09:00:00Z",
          "updated_at": "2026-07-30T09:12:00Z"
        },
        {
          "document_id": "book-networks",
          "filename": "networks.pdf",
          "title": "Computer Networks",
          "media_type": "application/pdf",
          "page_count": 510,
          "status": "ready",
          "error": null,
          "created_at": "2026-07-30T09:00:00Z",
          "updated_at": "2026-07-30T09:14:00Z"
        }
      ],
      "error": null,
      "created_at": "2026-07-30T09:00:00Z",
      "updated_at": "2026-07-30T09:14:00Z"
    }
  ],
  "x-invalidExamples": [
    {
      "reason": "A ready collection cannot contain an unprocessed document.",
      "value": {
        "schema_version": "source-collection-v1",
        "collection_id": "collection-invalid",
        "owner_id": "S-2026-000001",
        "status": "ready",
        "documents": [
          {
            "document_id": "book-pending",
            "filename": "pending.pdf",
            "title": "Pending",
            "media_type": "application/pdf",
            "page_count": 10,
            "status": "registered",
            "error": null,
            "created_at": "2026-07-30T09:00:00Z",
            "updated_at": "2026-07-30T09:00:00Z"
          }
        ],
        "error": null,
        "created_at": "2026-07-30T09:00:00Z",
        "updated_at": "2026-07-30T09:00:00Z"
      }
    }
  ]
}
