{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://univai.local/contracts/programme-plan-v1",
  "title": "UnivAI Programme Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "collection_id",
    "owner_id",
    "plan_version",
    "parent_plan_version",
    "status",
    "semesters",
    "workload_hours",
    "confidence",
    "approved_by",
    "approved_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "programme-plan-v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "collection_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "parent_plan_version": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "status": {
      "enum": ["proposed", "approved"]
    },
    "semesters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/semester"
      }
    },
    "workload_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "approved_by": {
      "type": ["string", "null"]
    },
    "approved_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "approved_by": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "pageRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "page_ranges", "sections"],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "page_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pageRange"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lecture_id",
        "title",
        "topics",
        "source_coverage",
        "workload_hours",
        "confidence"
      ],
      "properties": {
        "lecture_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceCoverage"
          }
        },
        "workload_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "title",
        "kind",
        "source_coverage",
        "weight_percent",
        "workload_hours",
        "confidence"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["quiz", "midterm", "final", "project"]
        },
        "source_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceCoverage"
          }
        },
        "weight_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "workload_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_id",
        "title",
        "prerequisites",
        "lectures",
        "assessments",
        "workload_hours",
        "confidence"
      ],
      "properties": {
        "course_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lectures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lecture"
          }
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        },
        "workload_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "semester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semester_id", "title", "sequence", "courses"],
      "properties": {
        "semester_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "courses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/course"
          }
        }
      }
    }
  },
