# Public host. DNS must point to this server before Caddy requests TLS.
DOMAIN=learn.example.com
ACME_EMAIL=admin@example.com

# Each application is built and published by its own repository/workflow.
UNIVAI_APP_IMAGE=ghcr.io/devabdotolba/univai-app:mvp2
UNIVAI_AGENT_IMAGE=ghcr.io/devabdotolba/univai-agent:mvp2
UNIVAI_LIVE_IMAGE=ghcr.io/devabdotolba/univai-live:mvp2
UNIVAI_EXAM_IMAGE=ghcr.io/devabdotolba/univai-exam:mvp2
UNIVAI_CORE_IMAGE=ghcr.io/devabdotolba/univai-core:mvp2

# Secrets are deliberately blank. Generate unique values on the host.
POSTGRES_PASSWORD=
MONGO_ROOT_USERNAME=univai
MONGO_ROOT_PASSWORD=
QDRANT_API_KEY=
BETTER_AUTH_SECRET=
EXAM_CALLBACK_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=UnivAI <notifications@learn.example.com>
NOTIFICATION_DISPATCH_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PRODUCT_ID=
PAYPAL_SUPPORTER_PLAN_ID=
PAYPAL_PATRON_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# Non-secret deployment settings.
SUPER_ADMIN_EMAIL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_WEBHOOK_URL=https://learn.example.com/api/subscriptions/paypal/webhook
