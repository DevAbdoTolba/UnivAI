{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:univai:evaluation:model-output:v2",
  "title": "UnivAI captured evaluation output row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "response", "observed_behavior", "refused", "citations_json",
    "latency_ms", "trace_id", "model_id", "prompt_version", "schema_valid",
    "http_status", "error_code", "tool_calls_json", "tool_trace_complete", "reviewer_1_id",
    "reviewer_1_date", "reviewer_1_verdict", "reviewer_1_semantic_correctness",
    "reviewer_1_claim_entailment", "reviewer_1_language_quality",
    "reviewer_1_attack_handling", "reviewer_2_id", "reviewer_2_date",
    "reviewer_2_verdict", "reviewer_2_semantic_correctness",
    "reviewer_2_claim_entailment", "reviewer_2_language_quality",
    "reviewer_2_attack_handling", "adjudicator_id", "adjudication_date",
    "adjudicator_verdict", "adjudicator_notes", "human_notes"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "response": {"type": "string"},
    "observed_behavior": {
      "type": "string",
      "enum": ["answer_with_citation", "authorization_refusal", "correct_false_premise", "grounded_refusal", "policy_refusal", "safe_answer", "safety_refusal", "schema_rejected", "validation_error"]
    },
    "refused": {"type": "string", "enum": ["true", "false"]},
    "citations_json": {"type": "string", "description": "JSON-encoded array of structured Citation objects; validated by the offline scorer."},
    "latency_ms": {"type": "string", "pattern": "^[0-9]+$"},
    "trace_id": {"type": "string"},
    "model_id": {"type": "string"},
    "prompt_version": {"type": "string"},
    "schema_valid": {"type": "string", "enum": ["", "true", "false"]},
    "http_status": {"type": "string", "pattern": "^$|^[1-5][0-9]{2}$"},
    "error_code": {"type": "string"},
    "tool_calls_json": {"type": "string", "description": "JSON-encoded array of captured ToolCall objects; validated by the offline scorer."},
    "tool_trace_complete": {"type": "string", "enum": ["", "true", "false"]},
    "reviewer_1_id": {"type": "string"},
    "reviewer_1_date": {"type": "string"},
    "reviewer_1_verdict": {"type": "string", "enum": ["", "PASS", "FAIL"]},
    "reviewer_1_semantic_correctness": {"$ref": "#/$defs/dimension"},
    "reviewer_1_claim_entailment": {"$ref": "#/$defs/dimension"},
    "reviewer_1_language_quality": {"$ref": "#/$defs/dimension"},
    "reviewer_1_attack_handling": {"$ref": "#/$defs/dimension"},
    "reviewer_2_id": {"type": "string"},
    "reviewer_2_date": {"type": "string"},
    "reviewer_2_verdict": {"type": "string", "enum": ["", "PASS", "FAIL"]},
    "reviewer_2_semantic_correctness": {"$ref": "#/$defs/dimension"},
    "reviewer_2_claim_entailment": {"$ref": "#/$defs/dimension"},
    "reviewer_2_language_quality": {"$ref": "#/$defs/dimension"},
    "reviewer_2_attack_handling": {"$ref": "#/$defs/dimension"},
    "adjudicator_id": {"type": "string"},
    "adjudication_date": {"type": "string"},
    "adjudicator_verdict": {"type": "string", "enum": ["", "PASS", "FAIL"]},
    "adjudicator_notes": {"type": "string"},
    "human_notes": {"type": "string"}
  },
  "$defs": {
    "dimension": {"type": "string", "enum": ["", "PASS", "FAIL", "NA"]},
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "document_id", "page", "section", "excerpt_sha256"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "arguments_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["attempted", "blocked", "succeeded", "failed"]},
        "arguments_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
