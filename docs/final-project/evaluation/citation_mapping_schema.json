{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:univai:evaluation:citation-map:v2",
  "title": "UnivAI captured fixture-to-production citation map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_status",
    "dataset_version",
    "corpus_id",
    "captured_at",
    "capture_adapter",
    "source_document_sha256",
    "mappings"
  ],
  "properties": {
    "schema_version": {"const": "univai.evaluation-citation-map.v2"},
    "mapping_status": {"const": "captured"},
    "dataset_version": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "capture_adapter": {"type": "string", "minLength": 1},
    "source_document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/citation"}
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "document_id", "page", "section", "excerpt_sha256"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
