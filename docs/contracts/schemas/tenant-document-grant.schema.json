{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://univai.local/contracts/tenant-document-grant-v1.schema.json",
  "title": "TenantDocumentGrantV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "tenant_id", "collection_id", "document_id", "content_key", "display", "status", "granted_at", "revoked_at"],
  "properties": {
    "schema_version": { "const": "tenant-document-grant-v1" },
    "grant_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "collection_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "content_key": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}\\.pipeline:[a-f0-9]{64}$" },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "title"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "enum": ["active", "revoked"] },
    "granted_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
