{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://univai.local/contracts/section-pack-v1.schema.json",
  "title": "SectionPackV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "section_pack_id", "tenant_id", "programme_id", "course_id", "week", "lecture_id", "approved_plan_id", "approved_plan_version", "prompt_trace", "objectives", "duration_minutes", "activities"],
  "properties": {
    "schema_version": { "const": "section-pack-v1" },
    "section_pack_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "programme_id": { "type": "string", "minLength": 1 },
    "course_id": { "type": "string", "minLength": 1 },
    "week": { "type": "integer", "minimum": 1 },
    "lecture_id": { "type": "string", "minLength": 1 },
    "approved_plan_id": { "type": "string", "minLength": 1 },
    "approved_plan_version": { "type": "integer", "minimum": 1 },
    "prompt_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "prompt_version"],
      "properties": {
        "prompt_id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 }
      }
    },
    "objectives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "duration_minutes": { "type": "integer", "minimum": 1, "maximum": 180 },
    "activities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity_id", "kind", "order", "time_box_minutes", "title", "steps", "todo", "provenance"],
        "properties": {
          "activity_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["worked_example", "guided_task", "todo"] },
          "order": { "type": "integer", "minimum": 1 },
          "time_box_minutes": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "provenance"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "provenance": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["document_id", "page_start", "page_end", "section", "passage_ids"],
                    "properties": {
                      "document_id": { "type": "string", "minLength": 1 },
                      "page_start": { "type": "integer", "minimum": 1 },
                      "page_end": { "type": "integer", "minimum": 1 },
                      "section": { "type": "string", "minLength": 1 },
                      "passage_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                    }
                  }
                }
              }
            }
          },
          "todo": { "type": ["string", "null"] },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document_id", "page_start", "page_end", "section", "passage_ids"],
              "properties": {
                "document_id": { "type": "string", "minLength": 1 },
                "page_start": { "type": "integer", "minimum": 1 },
                "page_end": { "type": "integer", "minimum": 1 },
                "section": { "type": "string", "minLength": 1 },
                "passage_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  }
}
