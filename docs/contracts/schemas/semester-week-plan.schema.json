{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://univai.local/contracts/semester-week-plan-v1.schema.json",
  "title": "SemesterWeekPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_version", "learning_path_id", "learning_path_version", "tenant_id", "semester_id", "week_count", "weeks", "schedule_items"],
  "properties": {
    "schema_version": { "const": "semester-week-plan-v1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_version": { "type": "integer", "minimum": 1 },
    "learning_path_id": { "type": "string", "minLength": 1 },
    "learning_path_version": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "semester_id": { "type": "string", "minLength": 1 },
    "week_count": { "type": "integer", "minimum": 1 },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week", "document_id", "chapter_ids", "objective_ids", "lecture_id", "section_pack_id"],
        "properties": {
          "week": { "type": "integer", "minimum": 1 },
          "document_id": { "type": "string", "minLength": 1 },
          "chapter_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "objective_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "lecture_id": { "type": "string", "minLength": 1 },
          "section_pack_id": { "type": ["string", "null"] }
        }
      }
    },
    "schedule_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schedule_item_id", "week", "sequence", "session_type", "artifact_id", "starts_at", "status"],
        "properties": {
          "schedule_item_id": { "type": "string", "minLength": 1 },
          "week": { "type": "integer", "minimum": 1 },
          "sequence": { "type": "integer", "minimum": 1 },
          "session_type": { "enum": ["lecture", "section"] },
          "artifact_id": { "type": "string", "minLength": 1 },
          "starts_at": { "type": "string", "format": "date-time" },
          "status": { "enum": ["scheduled", "ready", "in_progress", "completed", "failed"] }
        }
      }
    }
  }
}
