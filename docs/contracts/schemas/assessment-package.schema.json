{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://univai.local/contracts/assessment-package-v1.schema.json",
  "title": "AssessmentPackageV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_contract", "package_id", "package_version", "kind", "tenant_id", "learner_id", "programme_id", "course_id", "learning_path_id", "learning_path_version", "approved_plan_id", "approved_plan_version", "blueprint", "generator_prompt", "scope", "questions", "created_at"],
  "properties": {
    "schema_version": { "const": "assessment-package-v1" },
    "package_contract": { "enum": ["quiz-package-v1", "midterm-package-v1", "final-package-v1"] },
    "package_id": { "type": "string", "minLength": 1 },
    "package_version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["quiz", "midterm", "final"] },
    "tenant_id": { "type": "string", "minLength": 1 },
    "learner_id": { "type": "string", "minLength": 1 },
    "programme_id": { "type": "string", "minLength": 1 },
    "course_id": { "type": "string", "minLength": 1 },
    "learning_path_id": { "type": "string", "minLength": 1 },
    "learning_path_version": { "type": "integer", "minimum": 1 },
    "approved_plan_id": { "type": "string", "minLength": 1 },
    "approved_plan_version": { "type": "integer", "minimum": 1 },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_id", "blueprint_version", "required_question_count", "integration_minimum", "max_week_concentration"],
      "properties": {
        "blueprint_id": { "type": "string", "minLength": 1 },
        "blueprint_version": { "type": "integer", "minimum": 1 },
        "required_question_count": { "type": "integer", "minimum": 1 },
        "integration_minimum": { "type": "integer", "minimum": 0 },
        "max_week_concentration": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "generator_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "prompt_version", "trace_id"],
      "properties": {
        "prompt_id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["week_numbers", "chapter_ids", "objective_ids", "semester_complete"],
      "properties": {
        "week_numbers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "chapter_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "objective_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "semester_complete": { "type": "boolean" }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "question_hash", "format", "prompt", "options", "correct_option", "answer_key", "rubric", "difficulty", "integration", "objective_ids", "provenance"],
        "properties": {
          "question_id": { "type": "string", "minLength": 1 },
          "question_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "format": { "enum": ["mcq", "short_answer", "essay"] },
          "prompt": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "correct_option": { "type": ["string", "null"] },
          "answer_key": { "type": "string", "minLength": 1 },
          "rubric": { "type": ["string", "null"] },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "integration": { "type": "boolean" },
          "objective_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document_id", "content_key", "week", "chapter_id", "page_start", "page_end", "section", "passage_ids"],
              "properties": {
                "document_id": { "type": "string", "minLength": 1 },
                "content_key": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}\\.pipeline:[a-f0-9]{64}$" },
                "week": { "type": "integer", "minimum": 1 },
                "chapter_id": { "type": "string", "minLength": 1 },
                "page_start": { "type": "integer", "minimum": 1 },
                "page_end": { "type": "integer", "minimum": 1 },
                "section": { "type": "string", "minLength": 1 },
                "passage_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
