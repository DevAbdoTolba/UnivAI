{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://univai.local/contracts/personalized-prompt-manifest-v1.schema.json",
  "title": "PersonalizedPromptManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "learner_id", "normalized_name_digest", "language", "voice", "model", "model_version", "sample_rate_hz", "phrase_set_version", "cache_key", "state", "clips", "created_at"],
  "properties": {
    "schema_version": { "const": "personalized-prompt-manifest-v1" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "learner_id": { "type": "string", "pattern": "^usr_[A-Za-z0-9_-]+$" },
    "normalized_name_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "voice": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "sample_rate_hz": { "type": "integer", "minimum": 8000, "maximum": 96000 },
    "phrase_set_version": { "type": "string", "minLength": 1 },
    "cache_key": { "type": "string", "pattern": "^prompt-cache/[a-f0-9]{64}$" },
    "state": { "enum": ["building", "ready", "repair_queued", "failed"] },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phrase_id", "template_version", "storage_key", "checksum", "media_type", "duration_ms"],
        "properties": {
          "phrase_id": { "type": "string", "minLength": 1 },
          "template_version": { "type": "string", "minLength": 1 },
          "storage_key": { "type": "string", "pattern": "^prompt-cache/[a-f0-9]{64}/[A-Za-z0-9._-]+$" },
          "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "media_type": { "enum": ["audio/wav", "audio/ogg"] },
          "duration_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
