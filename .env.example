# ---- LLM (provider:model). Fallback is OPTIONAL — empty = one model only. ----
# providers: ollama | gemini | openai | groq | grok | bedrock
#   ollama:qwen3:4b-instruct       local (the default; `make models` pulls it)
#   NOTE: sub-2B local models (gemma3:1b, qwen2.5:0.5b) are fast but cannot emit
#   the JSON course generation needs — every lecture fails "never produced valid
#   JSON". Keep 4B+ locally, or point at a cloud model below.
#   gemini:gemini-2.5-flash        needs GEMINI_API_KEY
#   openai:gpt-4o-mini             needs OPENAI_API_KEY (+OPENAI_BASE_URL for gateways)
#   groq:llama-3.3-70b-versatile   needs GROQ_API_KEY
#   grok:grok-3-mini               needs XAI_API_KEY
#   bedrock:us.meta.llama3-3-70b-instruct-v1:0   needs BEDROCK_API_KEY (+BEDROCK_BASE_URL)
LLM_PRIMARY=ollama:qwen3:4b-instruct
LLM_FALLBACK=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GROQ_API_KEY=
XAI_API_KEY=
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# ---- LiveKit — LOCAL docker server (starts with `make up`) ----
# devkey/secret are the livekit-server --dev built-ins; fine on localhost.
# 127.0.0.1, NOT localhost: the Rust rtc client tries ::1 first and can time
# out before falling back to IPv4 when a VPN/firewall drops IPv6 loopback.
LIVE_SESSION_TRANSPORT=livekit
# Generated private bundles stay outside Git. The default is ./demo-media.
DEMO_MEDIA_ROOT=./demo-media
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# same URL, exposed to the browser
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
# ---- LiveKit Cloud (free tier) — swap the four values above for a remote demo ----
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ---- RAG (the team's EXISTING service: github.com/AhmeedFatehy/UnivAI-Agent) ----
# Their MCP server speaks streamable-http. Start it with:  uv run python mcp_server.py
RAG_MCP_URL=http://localhost:8000/mcp
RAG_USER_ID=student
RAG_TOOL_SEARCH=retrieve_context
RAG_TOOL_INGEST=ingest_file
# Their retrieval never returns empty (a vector search always yields neighbours).
# Drop hits below this reranked score; the LLM still has to refuse off-book questions.
# Cross-encoder logits are not probabilities. 0 disables an absolute cutoff.
RAG_MIN_SCORE=0

# ---- Exams (UnivAI-exam_system submodule, port 3200) ----
MONGODB_URI=mongodb://localhost:27018/univai_exams
EXAM_SYSTEM_URL=http://localhost:3200
# Shared HMAC secret for both trusted app→exam final launches and signed
# exam→app result callbacks. Generate at least 32 random bytes.
EXAM_CALLBACK_SECRET=
# The exam service posts provisional/final result events here.
RESULT_WEBHOOK_URL=http://localhost:3100/api/exams/callback
STUDENT_NAME=Mohamed Hany

# ---- Data ----
DATABASE_URL=postgresql://univai:univai@localhost:5433/univai

# ---- Auth (Better Auth) — see docs/auth-plan.md + docs/auth-contract.md ----
# Signs session cookies. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's own origin (port 3100, matching APP_PORT in the Makefile).
BETTER_AUTH_URL=http://localhost:3100
# The one account auto-promoted to super_admin on signup (fill with the owner's email).
SUPER_ADMIN_EMAIL=
# Comma-separated, server-only access list for /dev (spaces are ignored).
DEVELOPER_EMAILS=mtolba2004@gmail.com,dev@gmail.com
# Transactional email for reset + verification links. Empty => links printed to
# the server console (dev fallback) instead of emailed. Set for production.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=UnivAI <onboarding@resend.dev>
# Long random bearer secret used only by the notification cron dispatcher.
NOTIFICATION_DISPATCH_SECRET=

# ---- PayPal monthly subscriptions (Sandbox by default) ----
# Keep the secret server-only. Create the two recurring plan IDs once with:
#   cd UnivAI-app && npx tsx scripts/setup-paypal-plans.ts
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_PRODUCT_ID=
PAYPAL_SUPPORTER_PLAN_ID=
PAYPAL_PATRON_PLAN_ID=
# Local presentation fallback only. Never enable in production.
PAYPAL_FAKE_SUBSCRIPTION=false
# Configure this after the deployed HTTPS webhook exists:
#   https://your-host/api/subscriptions/paypal/webhook
PAYPAL_WEBHOOK_URL=
PAYPAL_WEBHOOK_ID=

# ---- Google sign-in (optional) ----
# From a Google Cloud "OAuth client ID" of type Web application:
#   https://console.cloud.google.com/apis/credentials
# The client's Authorised redirect URI must be exactly BETTER_AUTH_URL plus
# /api/auth/callback/google — for local development:
#   http://localhost:3100/api/auth/callback/google
# Leave both empty to run without Google: the provider is not registered and the
# "Continue with Google" button does not render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Voice (all local; the model files live in the Mouth cave: UnivAI-live/models/) ----
# Where the voice models run. auto = GPU if there is one, else CPU.
DEVICE=auto
STT_COMPUTE_TYPE=float16   # GPU: float16 | CPU: int8
TTS_ENGINE=kokoro          # default on-demand lecture voice
TTS_LIVE_ENGINE=piper      # voice for LIVE answers: ~10x realtime, speech starts in <1s
KOKORO_MODEL=UnivAI-live/models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES=UnivAI-live/models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_heart
PIPER_MODEL=UnivAI-live/models/piper/en_US-lessac-medium.onnx
COQUI_TOS_AGREED=1
STT_ENGINE=faster-whisper
STT_MODEL_SIZE=base        # base | small

# ---- Paths ----
UPLOADS_DIR=./uploads
